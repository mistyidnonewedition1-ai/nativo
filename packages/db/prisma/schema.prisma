generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SkillKind {
  LISTENING
  SPEAKING
  PRONUNCIATION
  VOCABULARY
  GRAMMAR
  READING
  WRITING
  FLUENCY
  NATIVE_COMPREHENSION
}

enum Plan {
  FREE
  PREMIUM
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  plan         Plan               @default(FREE)
  createdAt    DateTime           @default(now())
  profile      UserProfile?
  sessions     AuthSession[]
  skillLevels  UserSkillLevel[]
  placements   PlacementSession[]
  lessonProgress LessonProgress[]
  answers      Answer[]
  reviews      VocabularyReview[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProfile {
  userId        String  @id
  goal          String
  dailyMinutes  Int
  targetRegion  String?
  uiLanguage    String  @default("fr")
  immersionMode Boolean @default(false)
  a11y          Json    @default("{}")
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkillLevel {
  userId     String
  skill      SkillKind
  level      CefrLevel
  score      Float
  confidence Float
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
}

// État du test de niveau adaptatif (réponses, estimations par compétence, question en cours).
model PlacementSession {
  id          String    @id @default(cuid())
  userId      String
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  state       Json
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model LessonProgress {
  userId      String
  lessonId    String
  score       Float
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// Trace de chaque réponse : alimentera la détection de faiblesses (errorTag).
model Answer {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  exerciseId String
  correct    Boolean
  responseMs Int
  errorTag   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

// État FSRS d'une carte (le contenu de la carte vit dans packages/content).
model VocabularyReview {
  userId       String
  vocabId      String
  lessonId     String
  stability    Float     @default(0)
  difficulty   Float     @default(0)
  dueAt        DateTime  @default(now())
  lapses       Int       @default(0)
  reps         Int       @default(0)
  lastReviewAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, vocabId])
  @@index([userId, dueAt])
}
